# ==============================================
# AI Merch Factory — Environment Variables
# ==============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# NEVER commit .env.local to version control.
# ==============================================

# Supabase project URL (found in Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public API key (found in Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — used server-side only (found in Project Settings → API)
SUPABASE_SERVICE_ROLE_KEY=

# Printful API key — used for product catalog and order creation
# Get one at: https://www.printful.com/dashboard/developer/api-keys
PRINTFUL_API_KEY=

# HuggingFace API token — used to call FLUX.1 for image generation
# Get one at: https://huggingface.co/settings/tokens
HF_API_KEY=

# Google Gemini API key — used for AI prompt enhancement
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
