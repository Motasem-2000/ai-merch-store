# ==============================================
# AI Merch Store - Environment Variables
# ==============================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Then fill in your actual keys below.
# DO NOT commit .env.local to version control.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# HuggingFace (FLUX.1 image generation)
HF_API_KEY=hf_your-huggingface-api-key

# Google Gemini (prompt enhancement)
GEMINI_API_KEY=your-gemini-api-key

# Printful (print-on-demand fulfillment)
PRINTFUL_API_KEY=your-printful-api-key
